		<!--	  <spring-boot.version>2.6.6</spring-boot.version>-->
		<poi.version>4.1.2</poi.version>
		<!--漏洞升级：jackson 2.16.0->2.18.8->2.18.11 修复 jackson-core 高危 CVE(2.x 向后兼容，三件套统一版本)-->
		<jackson-version>2.18.11</jackson-version>
		<!--漏洞升级：netty 4.1.135->4.1.137.Final 修复多子模块高危 CVE(sctp 要求 4.1.137)，netty-bom 统一管控-->
		<netty.version>4.1.137.Final</netty.version>
		<!--漏洞 CVE-2026-2332：修复版本 9.4.60 未在 Maven Central 发布(Jetty 9.4.x 自2026-01停发)，
		    Java 8 无法升级到 Jetty 10+(需 Java 11+)，本轮暂维持 9.4.58，详见修复说明-->
		<jetty.version>9.4.58.v20250814</jetty.version>
		<grpc.version>1.75.0</grpc.version>
		<ffmpeg.version>6.0-1.5.9</ffmpeg.version>
		<tomcat.version>9.0.91</tomcat.version>
		<bytedeco.java.version>1.5.9</bytedeco.java.version>
		<!--	  <curator.version>4.2.0</curator.version>-->
		<!--	  <zookeeper.version>3.4.13</zookeeper.version>-->
        <protobuf-java.version>3.25.5</protobuf-java.version>
		<guava.version>32.1.2-jre</guava.version>
		<fastjson.version>1.2.83</fastjson.version>
		<!--漏洞升级：hibernate 5.3.20->5.3.38 修复 CVE-2026-0603 高危(二阶SQL注入)，5.3.x 补丁版本-->
		<hibernate.version>5.3.38.Final</hibernate.version>
		<!--漏洞升级：jsoup 1.15.3->1.23.2 修复高危 CVE，Java 8 兼容-->
		<jsoup.version>1.23.2</jsoup.version>
		<!--漏洞升级：freemarker 2.3.32->2.3.35 修复严重 CVE，2.3.x 补丁版本，Java 8 兼容-->
		<freemarker.version>2.3.35</freemarker.version>
		<!--漏洞升级：assertj-core 3.22.0->3.27.7 修复高危 CVE(测试依赖)，3.27.x 仍支持 Java 8-->
		<assertj.version>3.27.7</assertj.version>
		<!--漏洞升级：micrometer-core 1.9.17->1.15.12 修复高危 CVE。
		    1.15.12 字节码为 Java 8(major=52)、OSGi 声明 JavaSE 1.8，公共 API 对 1.9 向后兼容；
		    由 spring-boot-starter-actuator(2.7.18) 传递引入，此处统一锁定-->
		<micrometer.version>1.15.12</micrometer.version>
